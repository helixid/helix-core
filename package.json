{
  "name": "@helixid/core",
  "version": "2.1.0",
  "description": "Fastify HTTP API primitives for Helix ID — self-hostable DID/VC/VP/agent business-logic layer, consumed by helix-server-enterprise and the OSS self-hosted server.",
  "license": "Apache-2.0",
  "homepage": "https://helixid.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helixid/helix-core.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "prisma/schema.prisma"
  ],
  "scripts": {
    "prepare": "pnpm run build",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test:deps": "true",
    "test": "pnpm run test:deps && vitest run --exclude 'tests/live/**' --coverage --passWithNoTests && node scripts/check-coverage-thresholds.mjs coverage/coverage-final.json 90 90 85 90 0 0 0 0",
    "test:all": "pnpm run test:deps && vitest run --passWithNoTests",
    "test:non-live": "pnpm run test:deps && vitest run --exclude 'tests/live/**' --passWithNoTests",
    "test:live": "pnpm run test:deps && vitest run tests/live --reporter=verbose --reporter=github-actions",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:coverage": "pnpm run test:deps && vitest run --exclude 'tests/live/**' --coverage --passWithNoTests && node scripts/check-coverage-thresholds.mjs coverage/coverage-final.json 90 90 85 90 0 0 0 0",
    "test:watch": "vitest",
    "test:security": "pnpm run test:deps && vitest run tests/security",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:test:prepare": "node scripts/prepare-test-db.mjs",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "test:e2e": "pnpm --filter @helixid/e2e run test",
    "workspace:build": "pnpm run build && pnpm -r --if-present run build",
    "workspace:typecheck": "pnpm run typecheck && pnpm -r --if-present run typecheck",
    "workspace:test": "pnpm run test && pnpm -r --if-present run test",
    "workspace:test:non-live": "pnpm run test:non-live && pnpm -r --if-present run test:non-live",
    "format": "prettier --write \"**/*.{ts,json,md}\" --ignore-path .gitignore",
    "generate:golden-vectors": "tsx scripts/generate-golden-vectors.ts",
    "setup": "tsx scripts/setup.ts",
    "setup:hedera": "tsx scripts/setup-hedera.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "@noble/curves": "^1.9.7",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/config": "^7.10.0",
    "better-sqlite3": "^12.11.1",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.2",
      "protobufjs": "8.0.2"
    },
    "patchedDependencies": {
      "@changesets/cli@3.0.2": "patches/@changesets__cli@3.0.2.patch"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@helixid/did-hedera": "^0.1.2",
    "@helixid/sdk-js": "^0.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bs58": "^5.0.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.57.1",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
