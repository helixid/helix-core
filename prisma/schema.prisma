// Prisma v7 schema
// See constitution §11 for core table list.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Did {
  id                   String      @id
  subjectType          String
  controller           String
  publicKey            String
  publicKeyMultibase   String?
  hederaTopicId        String      @default("")
  hederaSequenceNumber Int         @default(0)
  hederaTransactionId  String
  didDocument          Json
  deactivatedAt        DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  updates              DidUpdate[]
  vcs                  Vc[]

  @@index([id])
  @@index([publicKey])
  @@map("dids")
}

model DidUpdate {
  id                  String   @id @default(cuid())
  didId               String
  updateType          String
  hederaTransactionId String
  payload             Json
  createdAt           DateTime @default(now())
  did                 Did      @relation(fields: [didId], references: [id])

  @@map("did_updates")
}

model Vc {
  id               String    @id @default(cuid())
  vcId             String    @unique
  subjectDid       String
  subjectType      String
  vcJson           Json
  privilegeScopes  Json?
  statusListIndex  Int
  expiresAt        DateTime?
  revokedAt        DateTime?
  renewedByVcId    String?
  delegatedFrom    String?
  delegationDepth  Int?
  maxDelegationDepth Int?
  parentVcId       String?
  // Lookup columns, denormalised from vcJson so a credential can be found
  // without reading every row's JSON: the credential's own type (the entry
  // of `type` that is not VerifiableCredential), who signed it, the user it
  // was granted on behalf of (DelegationGrantCredential only) and the
  // canonical scope set (sorted, space-joined). A consent grant is one of
  // (userDid, subjectDid, issuerDid, scopeKey): same four, same grant.
  vcType           String?
  issuerDid        String?
  userDid          String?
  scopeKey         String?
  createdAt        DateTime  @default(now())
  did              Did       @relation(fields: [subjectDid], references: [id])

  @@index([subjectDid])
  @@index([vcId])
  @@index([parentVcId])
  @@index([subjectDid, vcType, issuerDid, userDid])
  @@map("vcs")
}

model StatusListEntry {
  id          String   @id @default(cuid())
  listId      String   @unique
  encodedList String
  nextIndex   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("status_list_entries")
}

// Custody-held private keys for every kind of DID the platform signs for
// (agent, service, issuer, user). Nobody holds their own key.
model DidKey {
  id                  String   @id @default(cuid())
  did                 String   @unique
  subjectType         String   @default("agent")
  encryptedPrivateKey String
  iv                  String
  authTag             String
  algorithm           String
  createdAt           DateTime @default(now())

  @@map("did_keys")
}

model EnrollmentToken {
  id               String      @id @default(cuid())
  tokenHash        String      @unique
  agentName        String
  requestedScopes  String
  requestedDomains String
  maxDelegationDepth Int         @default(0)
  expiresAt        DateTime?
  usedAt           DateTime?
  createdAt        DateTime    @default(now())
  challenges       Challenge[]

  @@map("enrollment_tokens")
}

model Challenge {
  id                  String           @id @default(cuid())
  challengeId         String           @unique
  nonce               String
  did                 String
  purpose             String
  pendingPublicKeyHex String?
  pendingDomains      String?
  pendingDidCreateStateJson String?
  pendingDidCreatePayloadHex String?
  expiresAt           DateTime
  verifiedAt          DateTime?
  createdAt           DateTime         @default(now())
  enrollmentToken     EnrollmentToken? @relation(fields: [enrollmentTokenId], references: [id])
  enrollmentTokenId   String?

  @@map("challenges")
}

// Enrolled Service Providers: the identity side (the DID) of a service. Its
// private key is in did_keys (subjectType 'service'); the VP-target lookup
// by name stays in service_registry. A hosted build attributes rows to
// accounts with its own link table rather than a column here.
model Service {
  id            String    @id
  did           String    @unique
  name          String
  domain        String
  requiredScope String
  description   String?
  // Free-form label ('express', 'flask', ...): recorded as given, never
  // used to select behaviour.
  framework     String?
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@index([name])
  @@map("services")
}

// Onboarded agents as records: the name an agent was onboarded with, its
// owner-controlled visibility, and what is known about its own onboarding
// credential (kept here so a registry can filter and page on status without
// reading `vcs`). Keyed by the agent DID. A hosted build attributes rows to
// accounts with its own link table rather than a column here, as for services.
model Agent {
  did                 String    @id
  name                String?
  // 'private' | 'public'. Nothing becomes public by default or by migration.
  visibility          String    @default("private")
  visibilityChangedAt DateTime?
  publishedAt         DateTime?
  credentialVcId      String?
  credentialExpiresAt DateTime?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([visibility, publishedAt])
  @@index([credentialVcId])
  @@map("agents")
}

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  eventType   String
  requestId   String
  payloadJson String
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([requestId])
  @@map("audit_log")
}

// KYA-OS story F-3: the custody choice of one agent, service or owner, keyed
// by its DID. keyCustody 'self' (the key is held client side) | 'helix' (in
// the KeyStore); didHosting 'own' (did:web on the owner's domain) | 'helix'
// (did:web under the Helix domain). status 'pending_key' (self-custody,
// waiting for `helix init`), 'pending_resolution' (own hosting, waiting for
// the documents to resolve from the owner's domain) or 'active'. A
// self-custody enrollment token is kept as its sha256 only.
model CustodyRecord {
  did                 String       @id
  subjectType         String
  keyCustody          String
  didHosting          String
  status              String
  kid                 String?
  name                String?
  ownerDid            String?
  scopes              Json?
  // What the agent-create route took on the enrollment token: the domains
  // published as the DID document's LinkedDomains entries (#domain-N), and
  // the maxDelegationDepth written on the identity credential.
  requestedDomains    Json?
  maxDelegationDepth  Int          @default(0)
  enrollmentTokenHash String?      @unique
  enrollmentExpiresAt DateTime?
  enrollmentNonce     String?
  enrollmentUsedAt    DateTime?
  credentialVcId      String?
  activatedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  keys                CustodyKey[]

  @@index([subjectType, keyCustody])
  @@map("custody_records")
}

// Every key a custody subject has had, public half only: where it is held
// ('self' | 'helix'), and its rotation state ('active', 'retiring' during the
// overlap after a custody change, 'revoked'). The DID document lists the
// active and retiring keys.
model CustodyKey {
  id           String        @id @default(cuid())
  did          String
  kid          String
  location     String
  publicKeyJwk Json
  status       String
  sequence     Int
  createdAt    DateTime      @default(now())
  retiresAt    DateTime?
  revokedAt    DateTime?
  record       CustodyRecord @relation(fields: [did], references: [did])

  @@unique([did, kid])
  @@map("custody_keys")
}

// KYA-OS story F-3, Helix-side key storage: the private keys Helix holds
// (custodial agents, services and owners; L3-H consent did:keys), each
// wrapped with AES-256-GCM under the key-encryption key named by kekId, the
// row's did, kid and subjectType bound in as associated data. Read and
// written only by DbKeyStore (stories rule 8). Shredding empties ciphertext
// and nonce and stamps shreddedAt; the public half stays for the record.
model WrappedKey {
  id           String    @id @default(cuid())
  did          String
  kid          String
  subjectType  String
  algorithm    String
  kekId        String
  nonce        String
  ciphertext   String
  publicKeyJwk Json
  createdAt    DateTime  @default(now())
  shreddedAt   DateTime?

  @@unique([did, kid])
  @@index([did])
  @@map("wrapped_keys")
}
