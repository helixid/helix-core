// Prisma v7 schema
// See constitution §11 for core table list.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Did {
  id                   String      @id
  subjectType          String
  controller           String
  publicKey            String
  publicKeyMultibase   String?
  hederaTopicId        String      @default("")
  hederaSequenceNumber Int         @default(0)
  hederaTransactionId  String
  didDocument          Json
  deactivatedAt        DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  updates              DidUpdate[]
  vcs                  Vc[]

  @@index([id])
  @@index([publicKey])
  @@map("dids")
}

model DidUpdate {
  id                  String   @id @default(cuid())
  didId               String
  updateType          String
  hederaTransactionId String
  payload             Json
  createdAt           DateTime @default(now())
  did                 Did      @relation(fields: [didId], references: [id])

  @@map("did_updates")
}

model Vc {
  id               String    @id @default(cuid())
  vcId             String    @unique
  subjectDid       String
  subjectType      String
  vcJson           Json
  privilegeScopes  Json?
  statusListIndex  Int
  expiresAt        DateTime?
  revokedAt        DateTime?
  renewedByVcId    String?
  delegatedFrom    String?
  delegationDepth  Int?
  maxDelegationDepth Int?
  parentVcId       String?
  createdAt        DateTime  @default(now())
  did              Did       @relation(fields: [subjectDid], references: [id])

  @@index([subjectDid])
  @@index([vcId])
  @@index([parentVcId])
  @@map("vcs")
}

model StatusListEntry {
  id          String   @id @default(cuid())
  listId      String   @unique
  encodedList String
  nextIndex   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("status_list_entries")
}

// Custody-held private keys for every kind of DID the platform signs for
// (agent, service, issuer, user). Nobody holds their own key.
model DidKey {
  id                  String   @id @default(cuid())
  did                 String   @unique
  subjectType         String   @default("agent")
  encryptedPrivateKey String
  iv                  String
  authTag             String
  algorithm           String
  createdAt           DateTime @default(now())

  @@map("did_keys")
}

model EnrollmentToken {
  id               String      @id @default(cuid())
  tokenHash        String      @unique
  agentName        String
  requestedScopes  String
  requestedDomains String
  maxDelegationDepth Int         @default(0)
  expiresAt        DateTime?
  usedAt           DateTime?
  createdAt        DateTime    @default(now())
  challenges       Challenge[]

  @@map("enrollment_tokens")
}

model Challenge {
  id                  String           @id @default(cuid())
  challengeId         String           @unique
  nonce               String
  did                 String
  purpose             String
  pendingPublicKeyHex String?
  pendingDomains      String?
  pendingDidCreateStateJson String?
  pendingDidCreatePayloadHex String?
  expiresAt           DateTime
  verifiedAt          DateTime?
  createdAt           DateTime         @default(now())
  enrollmentToken     EnrollmentToken? @relation(fields: [enrollmentTokenId], references: [id])
  enrollmentTokenId   String?

  @@map("challenges")
}

// Enrolled Service Providers: the identity side (the DID) of a service. Its
// private key is in did_keys (subjectType 'service'); the VP-target lookup
// by name stays in service_registry. A hosted build attributes rows to
// accounts with its own link table rather than a column here.
model Service {
  id            String    @id
  did           String    @unique
  name          String
  domain        String
  requiredScope String
  description   String?
  // Free-form label ('express', 'flask', ...): recorded as given, never
  // used to select behaviour.
  framework     String?
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@index([name])
  @@map("services")
}

// Onboarded agents as records: the name an agent was onboarded with, its
// owner-controlled visibility, and what is known about its own onboarding
// credential (kept here so a registry can filter and page on status without
// reading `vcs`). Keyed by the agent DID. A hosted build attributes rows to
// accounts with its own link table rather than a column here, as for services.
model Agent {
  did                 String    @id
  name                String?
  // 'private' | 'public'. Nothing becomes public by default or by migration.
  visibility          String    @default("private")
  visibilityChangedAt DateTime?
  publishedAt         DateTime?
  credentialVcId      String?
  credentialExpiresAt DateTime?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([visibility, publishedAt])
  @@index([credentialVcId])
  @@map("agents")
}

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  eventType   String
  requestId   String
  payloadJson String
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([requestId])
  @@map("audit_log")
}
